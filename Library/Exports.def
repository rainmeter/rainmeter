LIBRARY
EXPORTS
	; Note: If new functions are added, the API\{x32,x64}\Rainmeter.lib files in the
	; rainmeter-plugin-sdk repo must be replaced by the ones in the PluginAPI artifact of the
	; build-signpath workflow run for the release.
	RmReadString
	RmReadFormula
	RmReplaceVariables
	RmPathToAbsolute
	RmExecute
	RmGet
	RmLog
	RmLogF
	LSLog
	ReadConfigString
	PluginBridge
	RmReadStringFromSection
	RmReadFormulaFromSection

	; Private
	RainmeterMain		@1 NONAME

	; 2-4 were for the non-UTF-16 pcre_ functions.
	pcre16_compile		@5 NONAME
	pcre16_exec			@6 NONAME
	pcre16_study		@7 NONAME
	
	SkinInstallerMain	@8 NONAME
