LIBRARY
EXPORTS
	; Note: If new functions are added, the Rainmeter.lib files in the rainmeter-plugin-sdk repo
	; (rainmeter-plugin-sdk\API\{x32,x64}) must be replaced by the corresponding file in
	; BuildOut\Release{32,64}\Obj\Library. Use Build.ps1 (which sets 'ExcludeTests') to minimize
	; the .lib size.
	RmReadString
	RmReadFormula
	RmReplaceVariables
	RmPathToAbsolute
	RmExecute
	RmGet
	RmLog
	RmLogF
	LSLog
	ReadConfigString
	PluginBridge
	RmReadStringFromSection
	RmReadFormulaFromSection

	; Private
	RainmeterMain		@1 NONAME

	; 2-4 were for the non-UTF-16 pcre_ functions.
	pcre16_compile		@5 NONAME
	pcre16_exec			@6 NONAME
	pcre16_study		@7 NONAME
	
	SkinInstallerMain	@8 NONAME
