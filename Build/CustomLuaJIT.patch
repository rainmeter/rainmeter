Rainmeter-specific LuaJIT changes

The LuaJIT sources are based on upstream commit 1edc3e52 and are kept
unmodified. The build copies them to its staging directory and applies this
patch before invoking src/msvcbuild.bat.

The patch:

- Disables FFI consistently for C compilation and DynASM generation.
- Omits collectgarbage, the built-in print, the package, bit, and jit libraries,
  io.popen, and os.exit.
- Creates closed default streams instead of exposing stdin, stdout, and stderr.
- Makes os.setlocale() return nil without changing the process locale.
- Protects Windows builds from invalid CRT parameters passed through strftime.
- Increases the maximum number of pattern captures to 256.

---

diff --git a/src/lib_base.c b/src/lib_base.c
--- a/src/lib_base.c
+++ b/src/lib_base.c
@@ -468,7 +468,7 @@ LJLIB_CF(gcinfo)
   return 1;
 }
 
-LJLIB_CF(collectgarbage)
+LJLIB_NOREG LJLIB_CF(collectgarbage)
 {
   int opt = lj_lib_checkopt(L, 1, LUA_GCCOLLECT,  /* ORDER LUA_GC* */
     "\4stop\7restart\7collect\5count\1\377\4step\10setpause\12setstepmul\1\377\11isrunning");
@@ -515,8 +515,7 @@ LJLIB_CF(newproxy)
   return 1;
 }
 
-LJLIB_PUSH("tostring")
-LJLIB_CF(print)
+LJLIB_NOREG LJLIB_CF(print)
 {
   ptrdiff_t i, nargs = L->top - L->base;
   cTValue *tv = lj_tab_getstr(tabref(L->env), strV(lj_lib_upvalue(L, 1)));
diff --git a/src/lib_init.c b/src/lib_init.c
--- a/src/lib_init.c
+++ b/src/lib_init.c
@@ -17,7 +17,6 @@
 
 static const luaL_Reg lj_lib_load[] = {
   { "",			luaopen_base },
-  { LUA_LOADLIBNAME,	luaopen_package },
   { LUA_TABLIBNAME,	luaopen_table },
   { LUA_IOLIBNAME,	luaopen_io },
   { LUA_OSLIBNAME,	luaopen_os },
@@ -25,7 +24,5 @@ static const luaL_Reg lj_lib_load[] = {
   { LUA_MATHLIBNAME,	luaopen_math },
   { LUA_DBLIBNAME,	luaopen_debug },
-  { LUA_BITLIBNAME,	luaopen_bit },
-  { LUA_JITLIBNAME,	luaopen_jit },
   { NULL,		NULL }
 };
 
diff --git a/src/lib_io.c b/src/lib_io.c
--- a/src/lib_io.c
+++ b/src/lib_io.c
@@ -419,7 +419,7 @@ LJLIB_CF(io_open)
   return iof->fp != NULL ? 1 : luaL_fileresult(L, 0, fname);
 }
 
-LJLIB_CF(io_popen)
+LJLIB_NOREG LJLIB_CF(io_popen)
 {
 #if LJ_TARGET_POSIX || (LJ_TARGET_WINDOWS && !LJ_TARGET_XBOXONE && !LJ_TARGET_UWP)
   const char *fname = strdata(lj_lib_checkstr(L, 1));
@@ -536,7 +536,10 @@ static GCobj *io_std_new(lua_State *L, FILE *fp, const char *name)
   setgcref(ud->metatable, gcV(L->top-3));
   iof->fp = fp;
   iof->type = IOFILE_TYPE_STDF;
-  lua_setfield(L, -2, name);
+  if (name != NULL)
+    lua_setfield(L, -2, name);
+  else
+    lua_pop(L, 1);
   return obj2gco(ud);
 }
 
@@ -546,8 +549,11 @@ LUALIB_API int luaopen_io(lua_State *L)
   copyTV(L, L->top, L->top-1); L->top++;
   lua_setfield(L, LUA_REGISTRYINDEX, LUA_FILEHANDLE);
   LJ_LIB_REG(L, LUA_IOLIBNAME, io);
-  setgcref(G(L)->gcroot[GCROOT_IO_INPUT], io_std_new(L, stdin, "stdin"));
-  setgcref(G(L)->gcroot[GCROOT_IO_OUTPUT], io_std_new(L, stdout, "stdout"));
-  io_std_new(L, stderr, "stderr");
+  /* Rainmeter does not expose the host process's standard streams. The
+  ** default input/output handles remain closed until io.input/io.output is
+  ** explicitly given a file by the script.
+  */
+  setgcref(G(L)->gcroot[GCROOT_IO_INPUT], io_std_new(L, NULL, NULL));
+  setgcref(G(L)->gcroot[GCROOT_IO_OUTPUT], io_std_new(L, NULL, NULL));
   return 1;
 }
diff --git a/src/lib_os.c b/src/lib_os.c
--- a/src/lib_os.c
+++ b/src/lib_os.c
@@ -9,6 +9,10 @@
 #include <errno.h>
 #include <time.h>
 
+#if defined(_MSC_VER)
+#include <crtdbg.h>
+#endif
+
 #define lib_os_c
 #define LUA_LIB
 
@@ -37,6 +41,16 @@
 
 #define LJLIB_MODULE_os
 
+#if defined(_MSC_VER)
+static void null_invalid_parameter_handler(const wchar_t *expression,
+	const wchar_t *function, const wchar_t *file, unsigned int line,
+	uintptr_t reserved)
+{
+  UNUSED(expression); UNUSED(function); UNUSED(file); UNUSED(line);
+  UNUSED(reserved);
+}
+#endif
+
 LJLIB_CF(os_execute)
 {
 #if LJ_NO_SYSTEM
@@ -109,7 +123,7 @@ LJLIB_CF(os_getenv)
   return 1;
 }
 
-LJLIB_CF(os_exit)
+LJLIB_NOREG LJLIB_CF(os_exit)
 {
   int status;
   if (L->base < L->top && tvisbool(L->base))
@@ -213,7 +227,25 @@ LJLIB_CF(os_date)
     setsbufL(sb, L);
     while (retry--) {  /* Limit growth for invalid format or empty result. */
       char *buf = lj_buf_need(sb, sz);
-      size_t len = strftime(buf, sbufsz(sb), s, stm);
+      size_t len;
+#if defined(_MSC_VER)
+      int old_report_mode = _CrtSetReportMode(_CRT_ASSERT, _CRTDBG_REPORT_MODE);
+      _invalid_parameter_handler old_handler =
+	_set_thread_local_invalid_parameter_handler(null_invalid_parameter_handler);
+      int crt_error;
+      _CrtSetReportMode(_CRT_ASSERT, 0);
+      errno = 0;
+#endif
+      len = strftime(buf, sbufsz(sb), s, stm);
+#if defined(_MSC_VER)
+      crt_error = errno;
+      _CrtSetReportMode(_CRT_ASSERT, old_report_mode);
+      _set_thread_local_invalid_parameter_handler(old_handler);
+      if (crt_error == EINVAL) {
+	setstrV(L, L->top++, &G(L)->strempty);
+	break;
+      }
+#endif
       if (len) {
 	setstrV(L, L->top++, lj_str_new(L, buf, len));
 	lj_gc_check(L);
@@ -265,21 +297,7 @@ LJLIB_CF(os_difftime)
 
 LJLIB_CF(os_setlocale)
 {
-#if LJ_TARGET_PSVITA
-  lua_pushliteral(L, "C");
-#else
-  GCstr *s = lj_lib_optstr(L, 1);
-  const char *str = s ? strdata(s) : NULL;
-  int opt = lj_lib_checkopt(L, 2, 6,
-    "\5ctype\7numeric\4time\7collate\10monetary\1\377\3all");
-  if (opt == 0) opt = LC_CTYPE;
-  else if (opt == 1) opt = LC_NUMERIC;
-  else if (opt == 2) opt = LC_TIME;
-  else if (opt == 3) opt = LC_COLLATE;
-  else if (opt == 4) opt = LC_MONETARY;
-  else if (opt == 6) opt = LC_ALL;
-  lua_pushstring(L, setlocale(opt, str));
-#endif
+  lua_pushnil(L);
   return 1;
 }

