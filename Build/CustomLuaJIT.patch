 @set LJARCH=x64
 @minilua
 @if errorlevel 8 goto :NO32
 @set DASC=vm_x86.dasc
-@set DASMFLAGS=-D WIN -D JIT -D FFI -D ENDIAN_LE -D FPU
+@set DASMFLAGS=-D WIN -D JIT %DASMFFI% -D ENDIAN_LE -D FPU
